# =============================================================================
# Variables de entorno – Sistema de Gestión de Recursos Humanos
# Copiá este archivo a .env y ajustá los valores.
# =============================================================================

# Django
DJANGO_SECRET_KEY=cambiá-esta-clave-por-una-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
# Usá "mysql" (por defecto) o "sqlite" para desarrollo sin MySQL
DB_ENGINE=mysql
DB_NAME=rrhh_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sesión (segundos) – cierre por inactividad ~30 min
SESSION_COOKIE_AGE=1800

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=rrhh@localhost
